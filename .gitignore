explore/insiders/*.zip
explore/insiders/source.html

# explore/insiders: generated CSV/JSON outputs, rebuildable by the committed
# scripts. Kept: the three small Tiingo validation summaries and the archive
# manifest, which the committed reports cite.
explore/insiders/*.csv
explore/insiders/*.json
!explore/insiders/tiingo_validation_summary.csv
!explore/insiders/tiingo_validation_splits.csv
!explore/insiders/tiingo_validation_missing_symbols.csv
!explore/insiders/french_archives_manifest.json

# explore/deletions: generated outputs of phase1.py, rebuildable.
explore/deletions/*.csv
explore/deletions/*.json

# explore/kalshi: raw Kalshi and MLB API responses and caches (~40 MB),
# regenerable by the scripts. Only top-level code and write-ups are tracked.
explore/kalshi/*
!explore/kalshi/*.py
!explore/kalshi/*.md

# explore/osap: raw Open Source Asset Pricing downloads (rebuildable via fetch.py)
